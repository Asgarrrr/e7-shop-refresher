# Build
/target

# Configuration locale (utiliser config.example.toml comme modèle)
/config.toml

# Captures / dumps éventuels
/captures
*.bin

# Notes internes — ne jamais publier
/info.txt
/BOT_COORDINATES.md
/UI_LAYER_REFERENCE.md

# Divers OS / éditeur
Thumbs.db
.DS_Store
.idea/
.vscode/

# Instructions agent — local, jamais publié
/CLAUDE.md

# Plans d'amélioration et worktrees d'agents — local, jamais commité
/plans
/.claude

# Runtime panic log (crash.log; app-data first, temp-dir fallback)
crash.log

# Packet captures. `pktmon start --capture` with no `-f` writes PktMon.etl into
# the working directory and grows it to 512 MB, so a capture session run from
# the repo root leaves one here. These hold real network traffic and must never
# reach a commit.
*.etl
*.pcap
*.pcapng
